{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyad.studio/schemas/company-work-item-v1.json",
  "title": "Eyad Studio Canonical Work Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "title",
    "project",
    "work_type",
    "problem_fingerprint",
    "status",
    "owner_unit",
    "preflight",
    "reuse_decision"
  ],
  "properties": {
    "work_id": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "project": {"type":"string","minLength":1},
    "work_type": {
      "enum":["RESEARCH","DESIGN","IMPLEMENTATION","PILOT","QA","SECURITY","AUTOMATION","CONTENT","OPERATIONS","OTHER"]
    },
    "problem_fingerprint": {
      "type":"object",
      "additionalProperties":false,
      "required":["problem","desired_outcome","subsystem"],
      "properties":{
        "problem":{"type":"string"},
        "desired_outcome":{"type":"string"},
        "subsystem":{"type":"string"},
        "constraints":{"type":"array","items":{"type":"string"}},
        "expected_artifacts":{"type":"array","items":{"type":"string"}}
      }
    },
    "status": {
      "enum":["UNCLAIMED","ACTIVE","BLOCKED","HOLD","VERIFYING","DONE","SUPERSEDED"]
    },
    "owner_unit":{"type":"string","minLength":1},
    "parent_work_id":{"type":["string","null"]},
    "dependencies":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "related_work_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "preflight":{
      "type":"object",
      "additionalProperties":false,
      "required":["internal_search_complete","matches","claim_collision_checked","freshness_reviewed","external_sid_check"],
      "properties":{
        "internal_search_complete":{"type":"boolean"},
        "matches":{"type":"array","items":{"type":"string"}},
        "claim_collision_checked":{"type":"boolean"},
        "freshness_reviewed":{"type":"boolean"},
        "external_sid_check":{"enum":["NOT_NEEDED","COMPLETE","PENDING"]}
      }
    },
    "match_class":{
      "enum":["NONE","EXACT_DUPLICATE","SEMANTIC_DUPLICATE","PARTIAL_OVERLAP","CONFLICT","DISTINCT"]
    },
    "reuse_decision":{
      "enum":["REUSE_AS_IS","REUSE_WITH_UPDATE","EXTEND_EXISTING","INTEGRATE_EXISTING","AUTOMATE_EXISTING","BUILD_NEW","HOLD","REJECT"]
    },
    "canonical_artifacts":{"type":"array","items":{"type":"string"}},
    "verifier":{"type":["string","null"]},
    "decision_log_ref":{"type":["string","null"]},
    "supersedes":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "notes":{"type":["string","null"]}
  }
}