+    private val voicePrefix = "kokoro-en-v0_19-"
 
+    private fun speakerForVoice(name: String?): Int? {
+        if (name == null || !name.startsWith(voicePrefix)) return null
+        val id = name.removePrefix(voicePrefix).toIntOrNull() ?: return null
+        val count = TtsEngine.tts?.numSpeakers() ?: return null
+        return id.takeIf { it in 0 until count }
+    }
+
+    // The upstream base implementation exposes at most one voice per locale.
+    // Kokoro has 11 speaker embeddings: expose each as a real Android Voice.
+    override fun onGetVoices(): MutableList<Voice> {
+        val count = TtsEngine.tts?.numSpeakers() ?: 0
+        return (0 until count).map { id ->
+            Voice(
+                "$voicePrefix$id",
+                Locale.US,
+                Voice.QUALITY_HIGH,
+                Voice.LATENCY_NORMAL,
+                false,
+                emptySet()
+            )
+        }.toMutableList()
+    }
+
+    override fun onIsValidVoiceName(voiceName: String?): Int =
+        if (speakerForVoice(voiceName) != null) TextToSpeech.SUCCESS else TextToSpeech.ERROR
+
+    override fun onLoadVoice(voiceName: String?): Int =
+        onIsValidVoiceName(voiceName)
+
+    override fun onGetDefaultVoiceNameFor(
