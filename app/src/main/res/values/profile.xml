    <string name="discovery_patient_flame_title">The Patient Flame</string>
    <string name="discovery_patient_flame_clue">A flame kept for many returns begins to remember the hand that lit it.</string>
    <string name="discovery_patient_flame_lore">Consistency leaves a different mark than intensity. The Castle has begun to recognize your return.</string>
    <string name="discovery_marginalia_gate_title">The Marginalia Gate</string>
    <string name="discovery_marginalia_gate_clue">Some doors are written in the margins rather than printed on the page.</string>
    <string name="discovery_marginalia_gate_lore">Enough passages have been preserved that your annotations now form a second text beside the books themselves.</string>
    <string name="discovery_deep_shelf_title">The Deep Shelf</string>
    <string name="discovery_deep_shelf_clue">Finished volumes gather weight. Eventually the shelf becomes a foundation.</string>
    <string name="discovery_deep_shelf_lore">Your completed books and first Path threshold now reinforce one another. The archive is becoming a place, not a list.</string>
    <string name="discovery_long_watch_title">The Long Watch</string>
    <string name="discovery_long_watch_clue">There is a point when time spent reading stops feeling counted.</string>
    <string name="discovery_long_watch_lore">Fifty hours have passed inside books. The Castle records the duration, but the deeper change cannot be measured in minutes.</string>
    <string name="discovery_veil_thins_title">When the Veil Thins</string>
    <string name="discovery_veil_thins_clue">Several marks must awaken before they begin to answer one another.</string>
    <string name="discovery_veil_thins_lore">Your earned sigils are no longer isolated milestones. Together they form the first readable pattern in the Veil.</string>
    <string name="discovery_unnamed_chamber_title">The Unnamed Chamber</string>
    <string name="discovery_unnamed_chamber_clue">The deepest chamber does not open to a single achievement.</string>
    <string name="discovery_unnamed_chamber_lore">A mature Path and a complete core sigil constellation have revealed a chamber that the early Castle could not name.</string>
    <string name="discovery_unknown_title">Veiled Discovery</string>
    <string name="discovery_unknown_clue">Its condition remains hidden.</string>
    <string name="discovery_unknown_lore">This discovery belongs to a reading history not yet described here.</string>

