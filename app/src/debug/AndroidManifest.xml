<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DEBUG-only Paper Curl experiment using fictional fixture pages.
             This is deliberately NOT a second MAIN/LAUNCHER activity: instrumentation,
             user home icons and PackageManager.getLaunchIntentForPackage() must always
             resolve to the real MainActivity, never to a synthetic test lab.
             QA can launch this exported activity explicitly via adb shell am start. -->
        <activity
            android:name=".debug.ExternalCurlArenaActivity"
            android:label="Veil · Curl Engine Lab"
            android:exported="true"
            android:taskAffinity="com.veilreader.app.externalcurl.lab">
            <!-- Intent is BROWSABLE but NOT MAIN/LAUNCHER. Only the test lab
                 handles this unique scheme; no production release route. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veilpaperlab" android:host="curl" />
            </intent-filter>
        </activity>
        <!-- Only the debug APK exposes fictional, inert review fixtures. -->
        <activity android:name=".ui.review.GrayfogReviewActivity" android:exported="true" android:taskAffinity="com.veilreader.app.grayfog.review" />
        <!-- Debug-only adb probe. Never merged into the release manifest. -->
        <activity
            android:name=".debug.ReaderDurabilityProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.veilreader.app.reader.durability.probe" />
    </application>
</manifest>
